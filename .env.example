# AI Waiter — пример конфигурации. Скопируйте в .env и заполните.
# .env не коммитится. Здесь только имена переменных и безопасные заглушки (ADR-2,
# docs/arch/feature-6-project-scaffold.md). Никаких реальных адресов, ключей и паролей.

# --- Режим: single (один процесс, без Redis) | scaled (Redis, arq, Docker Compose)
APP_MODE=single
# dev | test | prod
APP_ENV=dev

# --- Сервер (python -m app). В single допустим только loopback (127.0.0.1, ::1, localhost),
# снаружи — через туннель. В scaled внутри контейнера — 0.0.0.0.
HOST=127.0.0.1
PORT=8000
# В single — только 1. В scaled — число процессов api.
API_WORKERS=1

# --- PostgreSQL 16 (обязательно). Только схема postgresql+asyncpg://; БД создаётся с
# ENCODING 'UTF8' LOCALE 'C' (README, раздел «База данных»). Пароль — только символы,
# допустимые в URL, иначе его нужно URL-кодировать. Подключение ленивое: без доступной БД
# приложение стартует, а /health/ready отвечает 503 с "database": "fail".
DATABASE_URL=postgresql+asyncpg://ai_waiter:change-me@localhost:5432/ai_waiter
# Размер пула соединений одного процесса и сколько соединений можно открыть сверх него.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Тесты с PostgreSQL (pytest -m db). Это НЕ настройка приложения: её читают только тесты.
# Отдельная БД, имя обязано оканчиваться на _test — тесты пересоздают в ней схему public.
# Никогда не указывайте здесь рабочую БД.
# TEST_DATABASE_URL=postgresql+asyncpg://ai_waiter:change-me@localhost:5432/ai_waiter_test

# --- Redis (обязателен при APP_MODE=scaled)
# REDIS_URL=redis://redis:6379/0

# --- Внешний адрес — всегда домен, не IP (обязателен при APP_ENV=prod)
# PUBLIC_BASE_URL=https://menu.example.com

# --- Фронтенд (ADR-3)
SERVE_FRONTEND=true
# По умолчанию <repo>/frontend/dist
# FRONTEND_DIST_DIR=
MEDIA_DIR=media

# --- Swagger/OpenAPI: по умолчанию включён вне prod
# DOCS_ENABLED=

# --- Логи: DEBUG | INFO | WARNING | ERROR; json (по умолчанию, одна строка JSON) | console (разработка)
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- ИИ (#11). Модель — только из конфигурации.
# ANTHROPIC_API_KEY=
# AI_MODEL=

# --- Наблюдаемость (#32)
# SENTRY_DSN=

# --- Только docker-compose (режим scaled, deploy/docker-compose.yml)
# Скопируйте этот файл в deploy/.env и раскомментируйте строки ниже. APP_MODE, APP_ENV (prod),
# DATABASE_URL, REDIS_URL и PUBLIC_BASE_URL compose задаёт сам: из этих переменных и имён сервисов.
# Пароль — только символы, допустимые в URL (буквы, цифры, - _ .).
# POSTGRES_USER=ai_waiter
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=ai_waiter
# Домен, на который Caddy выпускает сертификат (DNS A-запись должна указывать на VPS).
# PUBLIC_DOMAIN=menu.example.com
# Частная подсеть сети caddy-api: api доверяет X-Forwarded-For только из неё.
# Не должна пересекаться с другими сетями хоста и Docker.
# EDGE_SUBNET=172.31.250.0/28
