# Режим scaled: TLS (сертификат Let's Encrypt выпускается автоматически) + reverse proxy.
# Статику и SPA fallback отдаёт api (ADR-3).
# Домен — из переменной окружения PUBLIC_DOMAIN (в репозитории доменов нет).
{$PUBLIC_DOMAIN} {
	encode zstd gzip

	header {
		# Без includeSubDomains: другие поддомены владельца домена могут работать без HTTPS.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Caddy не доверяет входящему X-Forwarded-For от клиентов (trusted_proxies не задан)
	# и передаёт в api реальный адрес клиента.
	# SSE (/api/.../stream) и WebSocket (/ws) проходят без буферизации.
	reverse_proxy api:8000 {
		flush_interval -1
	}
}
